#include "CPU_Bridge.h"

////////////////////////////////////////////////////////////////////////
RAW_BUFFER_BINDING( inIndirectOpsCount, 0 );
STRUCTURED_BUFFER_BINDING( IndirectOpDesc, inIndirectOps, 1 )

STORAGE_STRUCTURED_BUFFER_BINDING( IndirectOpsParserArgs, outIndirectArgs, 0 )
TYPED_STORAGE_BUFFER_BINDING( uint, outIndirectOpsCount, 1)

////////////////////////////////////////////////////////////////////////
#define X_SIZE OP_PARSE_SHDR_X
#define Y_SIZE OP_PARSE_SHDR_Y
BEGIN_MAIN( DECLARE_THREAD_GROUP_SIZE( X_SIZE, Y_SIZE, 1 ), INIT_DISPATCH_THREAD_ID_SEMANTIC( uint3, DTid ) )
{
    const uint id = DTid.x;
    const uint numIndirectOps = inIndirectOpsCount.Load( 0 );

    if( id == 0 )
        outIndirectOpsCount[ 0 ] = numIndirectOps;

    if( id >= numIndirectOps)
        return;

    IndirectOpDesc operation = inIndirectOps[ id ];
    IndirectOpsParserArgs outArgs = _IndirectOpsParserArgs();
    outArgs.type = operation.type;
    outArgs.count = operation.count;
    outArgs.data = operation.data;
    outArgs.stride = operation.stride;
    outArgs.threadCountX = DivideRoundUp( outArgs.count, OP_PARSE_SHDR_X );
    outArgs.threadCountY = 1;
    outArgs.threadCountZ = 1;

    outIndirectArgs[ id ] = outArgs;
}
END_MAIN